# ====================================================================
# InternMatch AI - Master Environment Variables Example (.env.example)
# Use this as a reference when configuring Render environment variables
# or your local .env file. NEVER commit real secrets to Git!
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Configuration (MySQL)
# --------------------------------------------------------------------
# Discrete component configuration:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=internmatch_db
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# Or combined JDBC connection string override:
# DB_URL=jdbc:mysql://localhost:3306/internmatch_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# --------------------------------------------------------------------
# 2. Security & Authentication
# --------------------------------------------------------------------
# Generate a cryptographically secure 256-bit string for production
JWT_SECRET=InternMatchSuperSecretKeyForJWTTokenGeneration2026SecureKeyWith256BitsLength

# --------------------------------------------------------------------
# 3. CORS & Frontend Origin
# --------------------------------------------------------------------
# Local: http://localhost:5173
# Production on Render: https://<your-frontend-service-name>.onrender.com
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# --------------------------------------------------------------------
# 4. Service-to-Service Communication URLs
# --------------------------------------------------------------------
# Local Defaults:
AUTH_SERVICE_URL=http://localhost:8081
STUDENT_SERVICE_URL=http://localhost:8082
COMPANY_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8084

# Production (Render) Example:
# AUTH_SERVICE_URL=https://internmatch-auth.onrender.com
# STUDENT_SERVICE_URL=https://internmatch-student.onrender.com
# COMPANY_SERVICE_URL=https://internmatch-company.onrender.com
# AI_SERVICE_URL=https://internmatch-ai.onrender.com

# --------------------------------------------------------------------
# 5. External APIs
# --------------------------------------------------------------------
# Groq AI Cloud API Key (Get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# External Profile APIs
LEETCODE_API_URL=https://alfa-leetcode-api.onrender.com/userProfile/

# Optional: Unstop API Key for live internship aggregation
UNSTOP_API_KEY=your_optional_unstop_api_key
UNSTOP_API_BASE_URL=https://unstop.com/api/public/opportunity/search-result

# --------------------------------------------------------------------
# 6. Email Delivery (Gmail SMTP for OTP Verification)
# --------------------------------------------------------------------
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password

